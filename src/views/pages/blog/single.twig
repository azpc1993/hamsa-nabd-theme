{% extends "layouts.master" %}
{% block content %}
<div class="container hn-blog-single"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><article class="hn-article"><h1>{{ article.title }}</h1><div class="hn-article__meta">{{ article.created_at|date }} · {{ article.author.name }}</div>{% if article.has_image %}<img class="hn-article__hero" src="{{ article.image.url }}" alt="{{ article.image.alt|default(article.title) }}">{% endif %}<div class="hn-article__body">{{ article.body|replace({'&nbsp;':' '})|raw }}</div>{% if article.tags|length %}<div class="hn-article__tags">{% for tag in article.tags %}<a href="{{ tag.url }}">#{{ tag.name }}</a>{% endfor %}</div>{% endif %}{% if store.settings.blog.allow_likes_and_comments %}<salla-comments item-id="{{ article.key }}" type="blog"></salla-comments>{% endif %}</article>{% if related|length %}<section class="hn-related-articles"><h2>{{ trans('pages.blog_articles.related') }}</h2>{% for item in related %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}</section>{% endif %}</div>
{% endblock %}
