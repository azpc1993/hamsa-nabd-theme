{% extends "layouts.master" %}
{% block content %}
<div class="container hn-blog-page"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><div class="hn-blog-layout"><aside class="hn-blog-cats"><h2>{{ trans('pages.blog_categories.categories') }}</h2>{% for category in categories %}<a class="{{ category.is_current?'is-active':'' }}" href="{{ category.url }}">{{ category.name }}</a>{% endfor %}</aside><main><h1 class="hn-page__title">{{ page.title }}</h1>{% if slides|length %}<salla-slider id="blog-home-slider" type="blog" auto-play pagination><div slot="items">{% for article in slides %}<article class="swiper-slide hn-blog-feature"><img src="{{ article.image.url }}" alt="{{ article.image.alt|default(article.title) }}"><div><span>{{ article.created_at|date }}</span><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.summary }}</p></div></article>{% endfor %}</div></salla-slider>{% endif %}{% if articles|length %}{% hook 'blog:index.items.start' %}<salla-infinite-scroll class="hn-blog-grid" next-page="{{ articles.next_page }}" autoload>{% for article in articles %}<article class="hn-blog-card"><a href="{{ article.url }}"><img src="{{ article.image.url }}" alt="{{ article.image.alt|default(article.title) }}"></a><div><span>{{ article.created_at|date }}</span><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.summary }}</p></div></article>{% endfor %}</salla-infinite-scroll>{% hook 'blog:index.items.end' %}{% else %}<div class="hn-empty-state"><i class="sicon-inbox"></i><p>{{ trans('pages.blog_categories.no_articles') }}</p></div>{% endif %}</main></div></div>
{% endblock %}
