{% extends "layouts.master" %}
{% block content %}<div class="container hn-loyalty-page"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><section class="hn-loyalty-hero" style="background-image:url('{{ loyalty.image }}')"><div><h1>{{ loyalty.name }}</h1><p>{{ loyalty.description }}</p>{% if user.loyalty_points is not null %}<strong>{{ user.loyalty_points }}</strong><span>{{ trans('pages.loyalty_program.point') }}</span>{% endif %}</div><salla-loyalty customer-points="{{ user.loyalty_points }}"></salla-loyalty></section><section><h2>{{ trans('pages.loyalty_program.ways_to_get_points') }}</h2><div class="hn-loyalty-grid">{% for point in loyalty.points %}<article><i class="{{ point.icon|default('sicon-star') }}"></i><strong>{{ point.points }}</strong><p>{{ point.description }}</p>{% if point.url %}<a href="{{ point.url }}">{{ point.name }}</a>{% endif %}</article>{% endfor %}</div></section>{% for group in loyalty.prizes %}<section><h2>{{ group.title }}</h2><salla-slider type="carousel" id="loyalty-slider-{{ group.type }}"><div slot="items">{% for prize in group.items %}<article class="slide--one-fourth hn-prize"><img src="{{ prize.image }}" alt="{{ prize.name }}"><h3>{{ prize.name }}</h3><p>{{ prize.description }}</p>{% if user.type == 'user' %}<strong>{{ prize.cost_points }} {{ trans('pages.loyalty_program.point') }}</strong>{% endif %}</article>{% endfor %}</div></salla-slider></section>{% endfor %}</div>{% endblock %}
