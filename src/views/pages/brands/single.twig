{% extends "layouts.master" %}
{% block content %}<div class="container hn-brand-single"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav>{% if brand.banner %}<img class="hn-brand-banner" src="{{ brand.banner }}" alt="{{ brand.name }}">{% endif %}<header class="hn-brand-head"><img src="{{ brand.logo }}" alt="{{ brand.name }}"><div><h1>{{ brand.name }}</h1><div>{{ brand.description|raw }}</div></div></header>{% hook 'brands:single.items.start' %}{% if products|length %}<salla-products-list data-testid="store-brand-products" source="{{ page.slug }}" source-value="{{ page.id }}"></salla-products-list>{% else %}<div class="hn-empty-state"><i class="sicon-box"></i><p>{{ trans('pages.brands.non_products') }} {{ brand.name }}</p></div>{% endif %}{% hook 'brands:single.items.end' %}</div>{% endblock %}
