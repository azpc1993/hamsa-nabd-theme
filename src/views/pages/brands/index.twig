{% extends "layouts.master" %}
{% block content %}<div class="container hn-brands-page"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><h1 class="hn-page__title">{{ page.title }}</h1>{% if brands|length %}{% for char, group in brands %}<section class="hn-brand-group"><h2>{{ char }}</h2><div class="hn-brand-grid">{% for brand in group %}<a href="{{ brand.url }}"><img src="{{ brand.logo }}" alt="{{ brand.name }}"><span>{{ brand.name }}</span></a>{% endfor %}</div></section>{% endfor %}{% else %}<div class="hn-empty-state"><i class="sicon-award-ribbon"></i><p>{{ trans('pages.brands.non_brands') }}</p></div>{% endif %}</div>{% endblock %}
