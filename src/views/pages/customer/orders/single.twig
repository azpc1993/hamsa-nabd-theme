{% extends "layouts.customer" %}
{% block inner_title %}<div class="hn-order-title-row"><h1 class="hn-page__title">{{ page.title }}</h1>{% if order.source is same as('buy_as_gift') %}<span class="hn-order-gift"><i class="sicon-gift-sharing"></i></span>{% endif %}<salla-edit-order-button data-testid="store-order-edit-btn" /></div>{% endblock %}
{% block inner_content %}
<div class="hn-order-page">
  {% hook 'customer:orders.single.details.start' %}
  <section class="hn-order-card"><div class="hn-order-meta"><span>{{ order.created_at|date }}</span><strong>{{ order.status.name }}</strong>{% if order.is_pending_payment and order.payment_url %}<salla-button href="{{ order.payment_url }}" class="hn-btn hn-btn--gold">{{ trans('hn.actions.pay_now') }}</salla-button>{% endif %}</div>{% if order.links|length %}<div class="hn-order-links">{% for link in order.links %}<a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a>{% endfor %}</div>{% endif %}</section>
  {% if order.is_pickable %}<salla-order-branch stack-cards></salla-order-branch>{% endif %}
  {% for package in order.packages %}<section class="hn-order-card">{% if package.shipping_company %}<div class="hn-order-shipping"><strong>{{ package.shipping_company.name }}</strong>{% if package.shipping_company.number %}<span>{{ package.shipping_company.number }}</span>{% endif %}{% if package.shipping_company.tracing_link %}<a href="{{ package.shipping_company.tracing_link }}" target="_blank" rel="noopener">{{ trans('hn.actions.track_shipment') }}</a>{% endif %}</div>{% endif %}{% for item in package.items %}<article class="hn-order-item"><a href="{{ item.product.url|default('#') }}"><img src="{{ item.image|default('images/placeholder.png'|asset) }}" alt="{{ item.name }}"></a><div><h3>{{ item.name }}</h3><p>{{ trans('pages.products.quantity') }}: {{ item.quantity }}</p><strong>{{ item.total|money }}</strong><salla-order-details order-details='{{ item|json_encode }}'></salla-order-details><salla-review-order-item product-id="{{ item.product.id }}"></salla-review-order-item>{% if item.note %}<p>{{ item.note }}</p>{% endif %}</div></article>{% endfor %}</section>{% endfor %}
  <salla-order-totals-card data-testid="store-order-totals" order="{{ order|json_encode }}"></salla-order-totals-card>
  {% if order.rating %}<section class="hn-order-card"><h2>{{ trans('pages.rating.rate_the_store') }}</h2>{% if order.rating.store %}<salla-rating-stars with-label value="{{ order.rating.store.stars }}"></salla-rating-stars>{% endif %}{% if order.rating.shipping %}<salla-rating-stars with-label value="{{ order.rating.shipping.stars }}"></salla-rating-stars>{% endif %}</section>{% endif %}
  {% hook 'customer:orders.single.details.end' %}
</div>
{% endblock %}
