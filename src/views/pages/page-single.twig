{#
| Variable     | Type   | Description |
|--------------|--------|-------------|
| page         | Page   |             |
| page.title   | string |             |
| page.content | string | HTML        |
| page.url     | string |             |
| page.slug    | string |             |
| page.type    | string | ex: "customised" for fully custom informative pages |
| page.id      | int    |             |
#}
{% extends "layouts.master" %}
{% block content %}

    {% if page.type == 'customised' %}
        {#
            Hook: information_page.information_page
            Fires before the main informative page content section.
            Use this hook to inject custom content or components above the page content area.
        #}
        <div class="s-blocks-wrapper s-information-page">{% hook 'information_page.information_page' %}</div>
    {% else %}
        <div class="hn-page container">
            <nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav>

            <div class="hn-page__content">
                <h1 class="hn-page__title">{{ page.title }}</h1>
                <div class="hn-page__body">
                    {{ page.content|raw }}
                </div>
                <salla-comments item-id="{{ page.id }}" type="page"></salla-comments>
            </div>
        </div>
    {% endif %}

{% endblock %}
