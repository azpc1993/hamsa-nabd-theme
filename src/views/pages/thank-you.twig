{% extends "layouts.master" %}
{% block content %}<div class="container hn-thankyou"><nav class="breadcrumbs"><salla-breadcrumb></salla-breadcrumb></nav><section class="hn-thankyou__card"><div class="hn-thankyou__icon"><i class="sicon-check-circle"></i></div><h1>{{ thank_you_title }}</h1><p>{{ trans('pages.thank_you.order_id') }} <strong>#{{ order.reference_id }}</strong></p><salla-button href="{{ order.url }}" class="hn-btn hn-btn--navy">{{ trans('hn.actions.order_details') }}</salla-button>{% if order.instructions %}<div class="hn-thankyou__instructions">{{ order.instructions|raw }}</div>{% endif %}{% for message in messages %}<p class="hn-thankyou__message">{{ message }}</p>{% endfor %}</section><salla-order-shipments class="hn-thankyou__shipments"></salla-order-shipments><salla-next-order-coupon></salla-next-order-coupon>{% if order.email_sent %}<section class="hn-thankyou__contact"><i class="sicon-mail-letter"></i><p>{{ trans('pages.thank_you.email_sent') }}</p><b>{{ order.customer.email }}</b></section>{% endif %}<section class="hn-thankyou__contact"><i class="sicon-headphones"></i><p>{{ trans('hn.titles.support') }}</p>{% if store.contacts.mobile %}<a href="tel:{{ store.contacts.mobile }}">{{ store.contacts.mobile }}</a>{% endif %}{% if store.contacts.whatsapp %}<a target="_blank" rel="noopener" href="https://wa.me/{{ store.contacts.whatsapp|replace({' ': '', '+': '', '-': ''}) }}">{{ store.contacts.whatsapp }}</a>{% endif %}</section></div>{% endblock %}
