{#
| Variable              | Type   | Description                                         |
|-----------------------|--------|-----------------------------------------------------|
| store.name/.logo/.url | Store  |                                                     |
| store.social          | object | instagram, snapchat, twitter, youtube, facebook...  |
| store.contacts        | object | mobile, phone, email, whatsapp, telegram            |
| theme.is_rtl          | bool   |                                                     |
| theme.color.primary   | string |                                                     |
| theme.settings.get()  | mixed  | قيم قسم settings في twilight.json                    |
| language.code         | string |                                                     |
| cart.items_count      | int    |                                                     |
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% hook 'head:start' %}
    {% block head %}{% endblock %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&family=Almarai:wght@300;400;700;800&display=swap" rel="stylesheet">

    {# أيقونات سلة (sicon-*) — بدونها تظهر أيقونات القلب والسلة والقائمة وواتساب فارغة #}
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}">
    <link rel="stylesheet" href="{{ 'style.css'|asset }}">
    <link rel="stylesheet" href="{{ 'components.css'|asset }}">

    <style>
        :root{
            /* اللون الأساسي يأتي من ميزة "color" في سلة (يختاره التاجر من لوحة التحكم)،
               وباقي ألوان الهوية ثابتة في ملفات CSS */
            --hn-primary: {{ theme.color.primary }};
            --hn-primary-text: {{ theme.color.text }};
            --hn-accent: #C9A24B;
            --hn-dark-bg: {{ theme.color.darker(0.35) }};
            --hn-bg: #FFFFFF;
            --hn-font-heading: 'Tajawal', sans-serif;
            --hn-font-body: 'Almarai', sans-serif;
            --hn-container-width: {{ theme.settings.get('hn_home_container_width','wide') == 'compact' ? '1120px' : (theme.settings.get('hn_home_container_width','wide') == 'standard' ? '1240px' : '1440px') }};
            --hn-section-gap: {{ theme.settings.get('hn_section_spacing','standard') == 'compact' ? '24px' : (theme.settings.get('hn_section_spacing','standard') == 'spacious' ? '64px' : '40px') }};
            --hn-card-radius: {{ theme.settings.get('hn_card_radius','soft') == 'sharp' ? '6px' : (theme.settings.get('hn_card_radius','soft') == 'rounded' ? '20px' : '12px') }};
            --hn-button-radius: {{ theme.settings.get('hn_button_radius','soft') == 'sharp' ? '6px' : (theme.settings.get('hn_button_radius','soft') == 'pill' ? '999px' : '10px') }};
        }
    </style>

    {% block styles %}{% endblock %}
    {% hook 'head' %}
    {% hook 'head:end' %}
</head>
<body class="hn-theme {% hook 'body:classes' %} {{ theme.is_rtl ? 'rtl' : 'ltr' }} {{ theme.settings.get('hn_home_container_width','wide') }} {{ theme.settings.get('hn_section_spacing','standard') }} {{ theme.settings.get('hn_card_radius','soft') }} {{ theme.settings.get('hn_card_shadow','soft') }} {{ theme.settings.get('hn_button_radius','soft') }} {{ theme.settings.get('hn_product_image_fit','cover') }}{% if theme.settings.get('hn_reduce_motion', false) %} hn-reduce-motion{% endif %}>
    {% hook 'body:start' %}

    {% if theme.settings.get('hn_show_announcement', true) %}{% include 'components.header.announcement-bar' %}{% endif %}
    {% component 'header.header' %}

    <main id="hn-main-content">
        {% block content %}{% endblock %}
    </main>

    {% component 'footer.footer' %}
    {% if theme.settings.get('hn_enable_whatsapp_float', true) %}{% include 'components.footer.whatsapp-float' %}{% endif %}

    {% hook 'body:end' %}
    {# نافذة العرض تُضاف من عناصر الصفحة الرئيسية (home.promo-popup) #}

    {% if theme.settings.get('enable_add_product_toast', true) %}
        <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
    {% endif %}

    <script defer src="{{ 'app.js'|asset }}"></script>
    <script defer src="{{ 'components.js'|asset }}"></script>

    {# Twilight Components #}
    <salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
    <salla-search data-testid="store-search-modal"></salla-search>
    <salla-login-modal data-testid="store-login-modal"></salla-login-modal>
    {% if store.scope %}
        <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
    {% endif %}

    {% block scripts %}{% endblock %}
</body>
</html>
