{#
| Variable         | Type   | Description                   |
|------------------|--------|-------------------------------|
| cart.items_count | int    |                               |
| cart.total       | string | مُنسّق مسبقاً ex: "١٠٠ ر.س"     |
| store.logo       | string |                               |
| store.name       | string |                               |
#}
<div class="hn-header {{ theme.settings.get('hn_header_sticky', true) ? 'is-sticky' : '' }}">
    <button class="hn-header__menu-btn" data-hn-menu-open aria-label="{{ trans('hn.accessibility.menu') }}">
        <span></span><span></span><span></span>
    </button>

    <a href="{{ store.url }}" class="hn-header__logo">
        {% if store.logo %}
            <img src="{{ store.logo }}" alt="{{ store.name }}">
        {% else %}
            <span class="hn-header__logo-text">{{ store.name }}</span>
        {% endif %}
    </a>

    {# بحث سلة الحيّ: اقتراحات فورية ونتائج حقيقية بدون كتابة أي منطق بحث #}
    {% if theme.settings.get('hn_show_header_search', true) %}<div class="hn-header__search">
        <salla-search inline oval height="48"></salla-search>
    </div>{% endif %}

    <div class="hn-header__actions">
        {% if theme.settings.get('hn_dark_mode_enable', true) %}<button type="button" class="hn-header__icon-link hn-theme-toggle" data-hn-theme-toggle aria-pressed="false" aria-label="{{ trans('hn.dark_mode.toggle') }}" title="{{ trans('hn.dark_mode.toggle') }}">
            <svg class="hn-theme-toggle__dark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="hn-theme-toggle__light" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>{% endif %}
        {% if theme.settings.get('hn_show_header_wishlist', true) %}<a href="{{ store.url }}/wishlist" class="hn-header__icon-link" aria-label="{{ trans('hn.accessibility.wishlist') }}">
            <i class="sicon-heart"></i>
            <salla-wishlist-summary></salla-wishlist-summary>
        </a>{% endif %}

        {% if theme.settings.get('hn_show_header_account', true) %}<salla-user-menu></salla-user-menu>{% endif %}

        {# ملخص السلة الرسمي — يفتح سلة سلة المنزلقة ويحدّث العدّاد تلقائياً #}
        <salla-cart-summary></salla-cart-summary>
    </div>
</div>
