{% set items = component.items|default([]) %}{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-tiktok"><div class="s-block__title"><h2>{{ component.title|default(trans('hn.features.tiktok_title')) }}</h2></div><div class="hn-tiktok__grid">{% for item in items %}<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="hn-tiktok__item"><img src="{{ item.thumbnail }}" alt="{{ item.title }}" loading="lazy"><span class="hn-tiktok__play">▶</span>{% if item.title %}<b>{{ item.title }}</b>{% endif %}</a>{% endfor %}</div></section>{% endif %}