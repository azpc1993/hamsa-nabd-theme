{# مكوّن سلة الأساسي: "صورة بخلفية متحركة" (feature: component-parallax-background) — image.url, title, url, link_text, is_opacity #}
{% if image|default(null) and image.url|default('') %}
<section component-id="{{ componentId }}" class="s-block hn-builtin hn-parallax" style="background-image:url('{{ image.url }}')">
  {% if is_opacity|default(false) %}<div class="hn-parallax__overlay"></div>{% endif %}
  <div class="hn-parallax__content">
    {% if title|default('') %}<h2>{{ title }}</h2>{% endif %}
    {% if url|default('') and link_text|default('') %}<a href="{{ url }}" class="hn-parallax__btn">{{ link_text }}</a>{% endif %}
  </div>
</section>
{% endif %}
