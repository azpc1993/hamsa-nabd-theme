{#
| Variable                          | Type    | Description                                    |
|------------------------------------|---------|------------------------------------------------|
| component.title                   | ?string | عنوان القسم                                     |
| component.departments[].image     | string  | صورة القسم (رجالي، نسائي، أطفال، مجوهرات...)     |
| component.departments[].name      | string  |                                                |
| component.departments[].tag       | ?string | كلمة صغيرة أعلى الصورة مثل "جديد" أو "الأكثر طلباً" |
| component.departments[].url       | string  |                                                |
| position                          | int     |                                                |
#}
{% set departments = component.departments|default([]) %}
{% if departments|length %}
<section component-id="{{ componentId }}" class="s-block hn-dept-grid-block">
    {% if component.title %}
        <div class="s-block__title"><h2>{{ component.title }}</h2></div>
    {% endif %}

    <div class="hn-dept-grid hn-dept-grid--{{ departments|length }}">
        {% for dept in departments %}
        <a href="{{ dept.url }}" class="hn-dept-card">
            <img src="{{ dept.image }}" alt="{{ dept.name }}" loading="lazy">
            <div class="hn-dept-card__overlay">
                {% if dept.tag %}<span class="hn-dept-card__tag">{{ dept.tag }}</span>{% endif %}
                <span class="hn-dept-card__name">{{ dept.name }}</span>
                <span class="hn-dept-card__cta">{{ trans('common.actions.view_all') }} <i class="sicon-keyboard_arrow_left"></i></span>
            </div>
        </a>
        {% endfor %}
    </div>
</section>
{% endif %}
