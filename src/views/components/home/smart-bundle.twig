{% if component.items|length %}<section component-id="{{ componentId }}" class="s-block hn-smart-bundle"><div class="s-block__title"><h2>{{ component.title|default(trans('hn.v93.bundle_title')) }}</h2>{% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}</div><div class="hn-smart-bundle__grid">{% for b in component.items %}<article class="hn-smart-bundle__card"><img src="{{ b.image }}" alt="{{ b.name }}" loading="lazy"><div class="hn-smart-bundle__body"><span class="hn-badge hn-badge--gold">{{ b.discount }}</span><h3>{{ b.name }}</h3><p>{{ b.products }}</p><strong>{{ b.price }}</strong>{% if b.url %}<a href="{{ b.url }}" class="hn-btn hn-btn--navy">{{ trans('hn.v93.view_bundle') }}</a>{% endif %}</div></article>{% endfor %}</div></section>{% endif %}