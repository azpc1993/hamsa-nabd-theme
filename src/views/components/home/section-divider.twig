{% set component = component|default({}) %}
{#
| Variable                | Type    |
|-------------------------|---------|
| component.title         | string  |
| component.subtitle      | ?string |
| component.link          | ?string |
| component.countdown_to  | ?date   |
| position                | int     |
#}
<section component-id="{{ componentId }}" class="s-block hn-divider">
    <div class="hn-divider__label">
        <div>
            <h2 class="hn-divider__title">{{ component.title }}</h2>
            {% if component.subtitle %}<p class="hn-divider__subtitle">{{ component.subtitle }}</p>{% endif %}
        </div>
    </div>
    {% if component.countdown_to %}
    <div class="hn-divider__countdown" data-hn-countdown="{{ component.countdown_to }}">
        <span data-unit="days">00</span>:<span data-unit="hours">00</span>:<span data-unit="minutes">00</span>:<span data-unit="seconds">00</span>
    </div>
    {% endif %}
    {% if component.link %}
    <a href="{{ component.link }}" class="hn-divider__link">{{ trans('hn.actions.view_all') }}</a>
    {% endif %}
</section>
