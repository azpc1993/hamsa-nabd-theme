{% set items = component.items|default([]) %}
{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-recommendations"><div class="s-block__title"><h2>{{ component.title|default(trans('hn.v92.recommendations_title')) }}</h2></div><div class="hn-recommendations__grid">{% for item in items %}<article class="hn-rec"><a href="{{ item.url|default('#') }}"><img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy"><div><h3>{{ item.name }}</h3><span>{{ item.price }}</span></div></a></article>{% endfor %}</div></section>{% endif %}