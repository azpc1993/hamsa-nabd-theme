{% set items = component.items|default([]) %}{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-recommendations hn-recommendations--v2" data-hn-recommendations>{% if component.title %}<div class="s-block__title"><h2>{{ component.title }}</h2></div>{% endif %}{% if component.tabs|length %}<div class="hn-rec-tabs" role="tablist">{% for tab in component.tabs %}<button type="button" class="hn-rec-tab{% if loop.first %} is-active{% endif %}" data-hn-rec-tab="{{ tab.value }}">{{ tab.label }}</button>{% endfor %}</div>{% endif %}<div class="hn-recommendations__grid">{% for item in items %}<article class="hn-rec" data-hn-rec-item="{{ item.segment|default('all') }}"><a href="{{ item.url|default('#') }}"><img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy"><div><small>{{ item.reason }}</small><h3>{{ item.name }}</h3><span>{{ item.price }}</span></div></a></article>{% endfor %}</div></section>{% endif %}