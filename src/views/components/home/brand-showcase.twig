{% set component = component|default({}) %}
{#
| Variable                  | Type   |
|---------------------------|--------|
| component.title           | ?string|
| component.tiles[].image   | string |
| component.tiles[].name    | string |
| component.tiles[].url     | string |
| position                  | int    |
#}
{% set tiles = component.tiles|default([]) %}
{% if tiles|length %}
<section component-id="{{ componentId }}" class="s-block">
    {% if component.title %}
        <div class="s-block__title"><h2>{{ component.title }}</h2></div>
    {% endif %}
    <div class="hn-brand-grid">
        {% for tile in tiles %}
        <a href="{{ tile.url }}" class="hn-brand-tile">
            <img src="{{ tile.image }}" alt="{{ tile.name }}" loading="lazy">
            <span class="hn-brand-tile__label">{{ tile.name }}</span>
        </a>
        {% endfor %}
    </div>
</section>
{% endif %}
