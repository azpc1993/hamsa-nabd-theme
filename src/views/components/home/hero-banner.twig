{% set component = component|default({}) %}
{% set slides = component.slides|default([]) %}
{% if slides|length %}
<section component-id="{{ componentId }}" class="s-block hn-hero" aria-label="{{ component.title|default('') }}">
    <div class="hn-hero__viewport">
        {% for slide in slides %}
        <article class="hn-hero__slide{% if not loop.first %} hn-hero__slide--secondary{% endif %}">
            <picture>
                {% if slide.image_mobile %}<source media="(max-width: 767px)" srcset="{{ slide.image_mobile }}">{% endif %}
                <img src="{{ slide.image }}" alt="{{ slide.title|default(store.name) }}" loading="{{ loop.first ? 'eager' : 'lazy' }}">
            </picture>
            <div class="hn-hero__content">
                {% if slide.title %}<h2 class="hn-hero__title">{{ slide.title }}</h2>{% endif %}
                {% if slide.subtitle %}<p class="hn-hero__subtitle">{{ slide.subtitle }}</p>{% endif %}
                {% if slide.url %}<a href="{{ slide.url }}" class="hn-btn hn-btn--gold">{{ slide.button_text|default(trans('hn.components.shop_now')) }}</a>{% endif %}
            </div>
        </article>
        {% endfor %}
    </div>
    {% if slides|length > 1 and component.hero_show_dots|default(true) %}
    <div class="hn-hero__dots" aria-hidden="true">{% for slide in slides %}<span{% if loop.first %} class="is-active"{% endif %}></span>{% endfor %}</div>
    {% endif %}
</section>
{% endif %}
