{% set component = component|default({}) %}
{% set o = {} %}{% for k in ['hero_text_position', 'hero_height_mode'] %}{% set v = attribute(component, k) %}{% if v is iterable %}{% set v = v.value ?? (v|first).value ?? null %}{% endif %}{% set o = o|merge({(k): v}) %}{% endfor %}
{% set hn_mod = ['hn-hero--pos-' ~ (o.hero_text_position ?: 'start'), 'hn-hero--h-' ~ (o.hero_height_mode ?: 'auto'), component.hero_overlay is same as(false) ? '' : 'hn-hero--overlay']|filter(c => c)|join(' ') %}
{#
| Variable                      | Type     | Description                                    |
|-------------------------------|----------|------------------------------------------------|
| component                     | object   | إعدادات التاجر من قسم components في twilight.json |
| component.slides[].image      | string   | رابط الصورة (كمبيوتر)                           |
| component.slides[].image_mobile | ?string| رابط الصورة (جوال)                              |
| component.slides[].title      | ?string  |                                                |
| component.slides[].subtitle   | ?string  |                                                |
| component.slides[].url        | ?string  |                                                |
| component.slides[].button_text| ?string  |                                                |
| component.slides[].video      | ?string  | رابط mp4 يظهر بدل الصورة (الصورة تبقى بديلاً)       |
| component.hero_autoplay       | ?bool    | تشغيل تلقائي للشرائح (افتراضي: نعم)                |
| position                      | int      | ترتيب العنصر في الصفحة، يبدأ من صفر              |
#}
{% set slides = component.slides|default([]) %}
{% if slides|length %}
<section component-id="{{ componentId }}" class="s-block hn-hero {{ hn_mod }}">
    <salla-slider
        id="hn-hero-{{ position }}"
        {{ component.hero_autoplay is same as(false) ? '' : 'auto-play' }}
        {{ component.hero_show_dots is same as(false) ? '' : 'pagination' }}
        static-when-single
        {{ slides|length > 1 ? '' : 'show-controls="false"' }}
        type="fullwidth">
        <div slot="items">
            {% for slide in slides %}
            <div class="swiper-slide hn-hero__slide">
                <picture>
                    {% if slide.image_mobile %}
                    <source media="(max-width: 767px)" srcset="{{ slide.image_mobile }}">
                    {% endif %}
                    <img src="{{ slide.image }}" alt="{{ slide.title|default(store.name) }}"
                         loading="{{ loop.first ? 'eager' : 'lazy' }}">
                </picture>
                {% if slide.video|default('')|trim %}
                <video class="hn-hero__video" autoplay muted loop playsinline preload="metadata" poster="{{ slide.image }}" aria-hidden="true">
                    <source src="{{ slide.video|trim }}" type="video/mp4">
                    <img src="{{ slide.image }}" alt="">
                </video>
                {% endif %}
                <div class="hn-hero__content">
                    {% if slide.title %}<h2 class="hn-hero__title">{{ slide.title }}</h2>{% endif %}
                    {% if slide.subtitle %}<p class="hn-hero__subtitle">{{ slide.subtitle }}</p>{% endif %}
                    {% if slide.url %}
                    <a href="{{ slide.url }}" class="hn-btn hn-btn--gold">
                        {{ slide.button_text|default(trans('hn.components.shop_now')) }}
                    </a>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </salla-slider>
</section>
{% endif %}
