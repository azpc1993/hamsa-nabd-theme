{# مكوّن سلة الأساسي: "مميزات المتجر" (feature: component-store-features) — items[].icon, items[].title, items[].text #}
{% set hn_items = items|default([]) %}
{% if hn_items|length %}
<section component-id="{{ componentId }}" class="s-block hn-builtin hn-store-features container">
  {% for item in hn_items %}
    <div class="hn-store-features__item">
      <i class="{{ item.icon|default('sicon-star') }}"></i>
      <h3>{{ item.title|default('') }}</h3>
      {% if item.text|default('') %}<p>{{ item.text }}</p>{% endif %}
    </div>
  {% endfor %}
</section>
{% endif %}
