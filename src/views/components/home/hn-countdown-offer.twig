{#
| Variable                 | Type                  | Description                                                   |
|--------------------------|-----------------------|---------------------------------------------------------------|
| component                | object                | Merchant settings for fields from twilight.json `components`  |
| component.background     | ?string               | Optional background image                                     |
| component.eyebrow        | ?string               |                                                               |
| component.title          | ?string               |                                                               |
| component.description    | ?string               |                                                               |
| component.end_date       | string                | "YYYY-MM-DD HH:mm:ss" (KSA time) or "YYYY-MM-DD"              |
| component.button_text    | ?string               |                                                               |
| component.button_url     | ?string               |                                                               |
| component.products       | Product[] *Collection | Products shown under the offer                                |
| position                 | int                   | Sorting number start from zero                                |
#}
{% set o = {} %}
{% for k in ['style', 'timer_style', 'timer_size'] %}
    {% set v = attribute(component, k) %}
    {% if v is iterable %}{% set v = v.value ?? (v|first).value ?? null %}{% endif %}
    {% set o = o|merge({(k): v}) %}
{% endfor %}
{% set hn_mod = [
    'sh-offer--' ~ (o.style ?: 'dark'),
    component.show_frame is same as(false) ? 'sh-offer--no-frame' : '',
    o.timer_style == 'plain' ? 'sh-offer--timer-plain' : ''
]|filter(c => c)|join(' ') %}
{% set hn_style = [
    ''
]|filter(c => c)|join(';') %}
{% set expired = component.hide_after_end and component.end_date and component.end_date|trim matches '/^[0-9]{4}-[0-9]{2}-[0-9]{2}/' and date(component.end_date|trim) < date() %}
{% if not expired %}
<section component-id="{{ componentId }}" data-testid="hn-countdown-offer" style="{{ hn_style }}" class="s-block sh-offer {{ hn_mod }} {% include 'components.hamsa.section-classes' %}">
    <div class="container">
        <div class="sh-offer__band sh-reveal" {% if component.background %}style="--sh-offer-bg: url('{{ component.background }}');"{% endif %}>
            <div class="sh-offer__text">
                {% if component.eyebrow %}<span class="sh-eyebrow">{{ component.eyebrow }}</span>{% endif %}
                {% if component.title %}<h2 class="sh-offer__title">{{ component.title }}</h2>{% endif %}
                {% if component.description %}<p class="sh-offer__desc">{{ component.description }}</p>{% endif %}
                {% if component.button_text and component.button_url %}
                    <a href="{{ component.button_url }}" class="sh-btn sh-btn--gold mt-6">{{ component.button_text }} <i class="sicon-arrow-left"></i></a>
                {% endif %}
            </div>
            {% if component.end_date %}
                <div class="sh-offer__timer">
                    <salla-count-down
                        date="{{ component.end_date|trim }}"
                        {{ o.timer_style == 'plain' ? '' : 'boxed' }}
                        labeled
                        size="{{ o.timer_size ?: 'lg' }}"
                        color="{{ o.style == 'light' or o.style == 'gold' ? 'dark' : 'light' }}"
                        box-color="rgba(255,255,255,.06)"
                        end-text="{{ trans('hn.blocks.offer_ended') }}"></salla-count-down>
                </div>
            {% endif %}
        </div>

        {% if component.products|length %}
            <div class="sh-offer__products">
                <salla-products-slider
                    data-testid="hn-countdown-offer-products"
                    source="selected"
                    source-value="[{{ component.products|map((product) => product.id)|join(',') }}]"
                    block-title=" "
                    slider-id="sh-offer-slider-{{ position }}"></salla-products-slider>
            </div>
        {% endif %}
    </div>
</section>
{% endif %}
