{#
| Variable                 | Type     | Description                                                   |
|--------------------------|----------|---------------------------------------------------------------|
| component.items          | object[] | Messages: icon, text, url                                     |
| component.gold           | bool     | Gold band (true) or black band (false) — used when style=auto |
| component.full_width     | bool     | Edge to edge (true) or inside the container                   |
| component.direction      | option   | to_left · to_right                                            |
| component.speed          | int      | Seconds per loop                                              |
| component.pause_on_hover | bool     |                                                               |
| component.style          | option   | auto · gold · dark · ivory · custom                           |
| component.bg_color       | ?color   | style=custom                                                  |
| component.text_color     | ?color   | style=custom                                                  |
| component.text_size      | option   | sm · md · lg                                                  |
| component.separator      | option   | icon · star · dot · none                                      |
| component.skew           | bool     | Tilted band                                                   |
| position                 | int      | Sorting number start from zero                                |
#}
{% set items = component.items|default([])|filter(i => i.text) %}
{% if items|length %}
{% set o = {} %}
{% for k in ['direction', 'style', 'text_size', 'separator'] %}
    {% set v = attribute(component, k) %}
    {% if v is iterable %}{% set v = v.value ?? (v|first).value ?? null %}{% endif %}
    {% set o = o|merge({(k): v}) %}
{% endfor %}
{% set style = o.style and o.style != 'auto' ? o.style : (component.gold ? 'gold' : 'dark') %}
{% set separator = o.separator ?: 'icon' %}
{% set vars = ['--sh-loop-speed:' ~ (component.speed ?: 38) ~ 's'] %}
{% if style == 'custom' and component.bg_color %}{% set vars = vars|merge(['--sh-mq-bg:' ~ component.bg_color]) %}{% endif %}
{% if style == 'custom' and component.text_color %}{% set vars = vars|merge(['--sh-mq-color:' ~ component.text_color]) %}{% endif %}
{# repeat short lists so one copy is always wider than the screen #}
{% set reps = (8 / items|length)|round(0, 'ceil') %}
{% set group = [] %}
{% for i in 1..(reps < 1 ? 1 : reps) %}{% set group = group|merge(items) %}{% endfor %}
<section component-id="{{ componentId }}" data-testid="hn-marquee"
         class="s-block sh-marquee sh-marquee--{{ style }} sh-marquee--{{ o.text_size ?: 'md' }} sh-marquee--sep-{{ separator }} {{ component.skew ? 'sh-marquee--skew' : '' }} {{ component.full_width ? '' : 'container' }} {% include 'components.hamsa.section-classes' %}"
         style="{{ vars|join(';') }}">
    <div class="sh-loop sh-loop--flush sh-loop--{{ (o.direction ?: 'to_left')|replace({'_': '-'}) }} {{ component.pause_on_hover is same as(false) ? '' : 'sh-loop--pause' }}"
         aria-label="{{ items|first.text|e('html_attr') }}">
        <div class="sh-loop__rail">
            {% for copy in 1..2 %}
                <ul class="sh-loop__track" {{ copy == 2 ? 'aria-hidden="true"' : '' }}>
                    {% for item in group %}
                        {% set hidden_copy = copy == 2 or loop.index > items|length %}
                        <li class="sh-loop__item sh-marquee__item">
                            {% if separator == 'icon' %}<i class="{{ item.icon ?: 'sicon-star2' }}" aria-hidden="true"></i>{% endif %}
                            {% if item.url %}<a href="{{ item.url }}" {{ hidden_copy ? 'tabindex="-1"' : '' }}>{{ item.text }}</a>{% else %}<span>{{ item.text }}</span>{% endif %}
                            {% if separator == 'star' %}<b class="sh-marquee__sep" aria-hidden="true">✦</b>{% elseif separator == 'dot' %}<b class="sh-marquee__sep" aria-hidden="true">•</b>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
