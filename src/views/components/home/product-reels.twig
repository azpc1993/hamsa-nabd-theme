{% set component = component|default({}) %}
{% set items = component.items|default([]) %}
{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-reels"><div class="s-block__title"><h2>{{ component.title|default(trans('hn.features.reels_title')) }}</h2></div><div class="hn-reels__track">{% for item in items %}<article class="hn-reel">{% if item.media ends with '.mp4' or item.media ends with '.webm' %}<video class="hn-reel__media" controls muted playsinline preload="metadata" poster="{{ item.poster }}"><source src="{{ item.media }}"></video>{% else %}<img class="hn-reel__media" src="{{ item.media }}" alt="{{ item.product_name }}" loading="lazy">{% endif %}<div class="hn-reel__body">{% if item.product_name %}<h3>{{ item.product_name }}</h3>{% endif %}{% if item.caption %}<p>{{ item.caption }}</p>{% endif %}{% if item.url %}<a href="{{ item.url }}" class="hn-btn hn-btn--gold">{{ trans('hn.features.shop_now') }}</a>{% endif %}</div></article>{% endfor %}</div></section>{% endif %}