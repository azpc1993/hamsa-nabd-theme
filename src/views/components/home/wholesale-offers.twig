{% set items = component.items|default([]) %}
{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-wholesale"><div class="s-block__title"><h2>{{ component.title|default(trans('hn.v92.wholesale_title')) }}</h2></div><div class="hn-wholesale__table"><div class="hn-wholesale__row hn-wholesale__head"><span>{{ trans('hn.v92.quantity') }}</span><span>{{ trans('hn.v92.discount') }}</span><span>{{ trans('hn.v92.price') }}</span></div>{% for item in items %}<div class="hn-wholesale__row"><span>{{ item.quantity }}</span><span>{{ item.discount }}</span><strong>{{ item.price }}</strong></div>{% endfor %}</div></section>{% endif %}