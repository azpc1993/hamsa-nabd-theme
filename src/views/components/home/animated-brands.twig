{% set component = component|default({}) %}
{% set items = component.items|default([]) %}{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-animated-brands"><div class="s-block__title"><h2>{{ component.title|default(trans('hn.features.brands_title')) }}</h2></div><div class="hn-animated-brands__track">{% for repeat in 1..2 %}{% for item in items %}<a href="{{ item.url|default('#') }}" class="hn-animated-brand" {{ repeat == 2 ? 'aria-hidden="true"' : '' }}><img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy"><span>{{ item.name }}</span></a>{% endfor %}{% endfor %}</div></section>{% endif %}