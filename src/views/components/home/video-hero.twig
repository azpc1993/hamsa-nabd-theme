{% set slides = component.items|default([]) %}
{% if slides|length %}<section component-id="{{ componentId }}" class="s-block hn-vhero">{% for item in slides %}<article class="hn-vhero__slide">{% if item.video %}<video class="hn-vhero__media" autoplay muted loop playsinline preload="metadata" poster="{{ item.poster }}"><source src="{{ item.video }}"></video>{% elseif item.image %}<img class="hn-vhero__media" src="{{ item.image }}" alt="{{ item.title }}" loading="lazy">{% endif %}<div class="hn-vhero__overlay"><span class="hn-eyebrow">{{ item.eyebrow }}</span><h2>{{ item.title }}</h2><p>{{ item.text }}</p>{% if item.url %}<a class="hn-btn hn-btn--gold" href="{{ item.url }}">{{ item.button_text|default(trans('hn.v92.shop_now')) }}</a>{% endif %}</div></article>{% endfor %}</section>{% endif %}