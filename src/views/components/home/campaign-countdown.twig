<section component-id="{{ componentId }}" class="s-block hn-campaign hn-smart-campaign" data-hn-countdown="{{ component.ends_at }}"{% if component.background %} style="--hn-campaign-bg:url('{{ component.background }}')"{% endif %}><div class="hn-campaign__content"><span class="hn-badge hn-badge--gold">{{ component.badge|default('Smart Campaign') }}</span><h2>{{ component.title }}</h2>{% if component.message or component.subtitle %}<p>{{ component.message|default(component.subtitle) }}</p>{% endif %}{% if component.code %}<div class="hn-smart-campaign__code">{{ trans('hn.v93.campaign_code') }} <strong>{{ component.code }}</strong></div>{% endif %}<div class="hn-campaign__timer"><span><b data-unit="days">00</b><small>{{ trans('hn.features.days') }}</small></span><span><b data-unit="hours">00</b><small>{{ trans('hn.features.hours') }}</small></span><span><b data-unit="minutes">00</b><small>{{ trans('hn.features.minutes') }}</small></span><span><b data-unit="seconds">00</b><small>{{ trans('hn.features.seconds') }}</small></span></div>{% if component.url %}<a href="{{ component.url }}" class="hn-btn hn-btn--gold">{{ component.button_text|default(trans('hn.features.shop_campaign')) }}</a>{% endif %}</div></section>