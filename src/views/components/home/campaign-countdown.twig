{% set component = component|default({}) %}
{% set o = {} %}
{% set hn_mod = ['hn-boxed']|filter(c => c)|join(' ') %}
{% if component.title or component.ends_at %}<section component-id="{{ componentId }}" class="s-block hn-campaign {{ hn_mod }} {% include 'components.hamsa.section-classes' %}" data-hn-countdown="{{ component.ends_at }}"><div class="hn-campaign__content"><h2>{{ component.title }}</h2>{% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}<div class="hn-campaign__timer"><span><b data-unit="days">00</b><small>{{ trans('hn.features.days') }}</small></span><span><b data-unit="hours">00</b><small>{{ trans('hn.features.hours') }}</small></span><span><b data-unit="minutes">00</b><small>{{ trans('hn.features.minutes') }}</small></span><span><b data-unit="seconds">00</b><small>{{ trans('hn.features.seconds') }}</small></span></div>{% if component.url %}<a href="{{ component.url }}" class="hn-btn hn-btn--gold">{{ component.button_text|default(trans('hn.features.shop_campaign')) }}</a>{% endif %}</div></section>{% endif %}