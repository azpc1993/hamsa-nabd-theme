{% set component = component|default({}) %}
{% set o = {} %}
{% set hn_mod = ['hn-boxed']|filter(c => c)|join(' ') %}
{#
| Variable                                  | Type    | Description                                         |
|---------------------------------------------|---------|------------------------------------------------------|
| component.title                            | ?string |                                                      |
| component.subtitle                         | ?string |                                                      |
| component.recipients[].label               | string  | مثال: "له"، "لها"، "للأطفال"                          |
| component.recipients[].icon                | string  |                                                      |
| component.occasions[].label                | string  | مثال: "مناسبة خاصة"، "هدية سريعة"، "عيد"، "تخرج"       |
| component.occasions[].icon                 | string  |                                                      |
| component.results[].recipient              | string  | يطابق نص recipients.label بالضبط                      |
| component.results[].occasion               | string  | يطابق نص occasions.label بالضبط                       |
| component.results[].title                  | string  | عنوان نتيجة الاقتراح                                  |
| component.results[].image                  | string  |                                                      |
| component.results[].url                    | string  | رابط تصنيف/منتج مقترح                                |
| position                                   | int     |                                                      |
#}
{% if component.recipients|length and component.occasions|length %}
<section component-id="{{ componentId }}" class="s-block hn-gift-finder {{ hn_mod }} {% include 'components.hamsa.section-classes' %}" data-hn-gift-finder
         data-results='{{ component.results|default([])|json_encode }}'>
    <div class="hn-gift-finder__head">
        <h2>{{ component.title|default(trans('hn.gift_finder.default_title')) }}</h2>
        {% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}
    </div>

    <div class="hn-gift-finder__body">
        <div class="hn-gift-finder__step is-active" data-hn-gf-step="0">
            <span class="hn-gift-finder__step-label">{{ trans('hn.gift_finder.step_recipient') }}</span>
            <div class="hn-gift-finder__options">
                {% for r in component.recipients %}
                <button class="hn-gift-finder__option" data-hn-gf-recipient="{{ r.label }}">
                    <img src="{{ r.icon }}" alt="">
                    <span>{{ r.label }}</span>
                </button>
                {% endfor %}
            </div>
        </div>

        <div class="hn-gift-finder__step" data-hn-gf-step="1">
            <span class="hn-gift-finder__step-label">{{ trans('hn.gift_finder.step_occasion') }}</span>
            <div class="hn-gift-finder__options">
                {% for o in component.occasions %}
                <button class="hn-gift-finder__option" data-hn-gf-occasion="{{ o.label }}">
                    <img src="{{ o.icon }}" alt="">
                    <span>{{ o.label }}</span>
                </button>
                {% endfor %}
            </div>
            <button class="hn-gift-finder__back" data-hn-gf-back>{{ trans('hn.gift_finder.back') }}</button>
        </div>

        <div class="hn-gift-finder__result" data-hn-gf-result hidden>
            <img data-hn-gf-result-img src="" alt="">
            <h3 data-hn-gf-result-title></h3>
            <a class="hn-btn hn-btn--navy" data-hn-gf-result-link href="#">{{ trans('hn.gift_finder.shop_now') }}</a>
            <button class="hn-gift-finder__restart" data-hn-gf-restart>{{ trans('hn.gift_finder.try_again') }}</button>
        </div>
    </div>
</section>
{% endif %}
