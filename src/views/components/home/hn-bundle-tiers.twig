{#
| Variable                   | Type     | Description                                                   |
|----------------------------|----------|---------------------------------------------------------------|
| component.eyebrow          | ?string  |                                                               |
| component.title            | ?string  |                                                               |
| component.description      | ?string  |                                                               |
| component.tiers            | object[] | 2–4 tiers: quantity, discount, note, highlighted              |
| component.button_text      | ?string  |                                                               |
| component.button_url       | ?string  |                                                               |
| position                   | int      | Sorting number start from zero                                |
#}
{% set o = {} %}
{% for k in ['style'] %}
    {% set v = attribute(component, k) %}
    {% if v is iterable %}{% set v = v.value ?? (v|first).value ?? null %}{% endif %}
    {% set o = o|merge({(k): v}) %}
{% endfor %}
{% set hn_mod = [
    'sh-tiers--' ~ (o.style ?: 'cards')
]|filter(c => c)|join(' ') %}
{% set hn_style = [
    component.columns ? '--sh-cols:' ~ component.columns : ''
]|filter(c => c)|join(';') %}
{% set tiers = component.tiers|default([])|filter(t => t.quantity or t.discount) %}
{% if tiers|length %}
<section component-id="{{ componentId }}" data-testid="hn-bundle-tiers" style="{{ hn_style }}" class="s-block sh-tiers {{ hn_mod }} {% include 'components.hamsa.section-classes' %}">
    <div class="container">
        <div class="sh-section-head sh-reveal">
            {% if component.eyebrow %}<span class="sh-eyebrow">{{ component.eyebrow }}</span>{% endif %}
            {% if component.title %}<h2 class="sh-section-head__title">{{ component.title }}</h2>{% endif %}
            {% if component.description %}<p class="sh-section-head__desc">{{ component.description }}</p>{% endif %}
        </div>
        <div class="sh-tiers__grid sh-tiers__grid--{{ tiers|length > 4 ? 4 : tiers|length }} {{ component.columns ? 'sh-cols' : '' }}">
            {% for tier in tiers %}
                <div class="sh-tier sh-reveal {{ tier.highlighted ? 'sh-tier--featured' : '' }}">
                    {% if tier.highlighted %}<span class="sh-tier__flag">{{ trans('blocks.hamsa.best_value') }}</span>{% endif %}
                    <span class="sh-tier__qty">{{ tier.quantity }}</span>
                    <span class="sh-tier__discount">{{ tier.discount }}</span>
                    {% if tier.note %}<span class="sh-tier__note">{{ tier.note }}</span>{% endif %}
                </div>
            {% endfor %}
        </div>
        {% if component.button_text and component.button_url %}
            <div class="text-center mt-8"><a href="{{ component.button_url }}" class="sh-btn sh-btn--dark">{{ component.button_text }} <i class="sicon-arrow-left"></i></a></div>
        {% endif %}
    </div>
</section>
{% endif %}
