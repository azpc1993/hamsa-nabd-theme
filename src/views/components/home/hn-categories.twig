{#
| Variable                   | Type       | Description                                                   |
|----------------------------|------------|---------------------------------------------------------------|
| component                  | object     | Merchant settings for fields from twilight.json `components`  |
| component.eyebrow          | ?string    |                                                               |
| component.title            | ?string    |                                                               |
| component.description      | ?string    |                                                               |
| component.use_custom       | bool       | Use custom items instead of store categories                  |
| component.categories       | object[]   | Store categories (id, name, url, image, icon)                 |
| component.items            | object[]   | Custom items: image, title, url                               |
| component.show_controls    | bool       | Slider arrows                                                 |
| component.layout           | option     | slider · marquee · scroll · grid                              |
| component.direction        | option     | to_left · to_right (marquee + slider autoplay)                |
| component.speed            | int        | Seconds per marquee loop                                      |
| component.pause_on_hover   | bool       |                                                               |
| component.autoplay         | bool       | Slider autoplay                                               |
| component.cols_desktop     | int        | Grid columns (desktop)                                        |
| component.cols_mobile      | int        | Grid columns (mobile)                                         |
| component.gap              | int        | Gap between items (px)                                        |
| component.shape            | option     | circle · squircle · square · arch · leaf · hexagon            |
| component.size             | option     | sm · md · lg · xl                                             |
| component.ring             | option     | gradient · solid · double · dashed · none                     |
| component.ring_width       | int        | px                                                            |
| component.ring_color       | ?color     |                                                               |
| component.ring_spin        | bool       | Rotate the gradient ring forever                              |
| component.inner_gap        | bool       | White gap between ring and image                              |
| component.image_fit        | option     | cover · contain                                               |
| component.image_bg         | option     | ivory · white · dark · gold                                   |
| component.hover            | option     | lift · zoom · glow · spin · none                              |
| component.shadow           | bool       |                                                               |
| component.grayscale        | bool       |                                                               |
| component.name_position    | option     | below · overlay · hidden                                      |
| component.name_size        | option     | sm · md · lg                                                  |
| component.name_color       | ?color     |                                                               |
| position                   | int        | Sorting number start from zero                                |
#}
{% set o = {} %}
{% for k in ['layout', 'direction', 'shape', 'size', 'ring', 'image_fit', 'image_bg', 'hover', 'name_position', 'name_size'] %}
    {% set v = attribute(component, k) %}
    {% if v is iterable %}{% set v = v.value ?? (v|first).value ?? null %}{% endif %}
    {% set o = o|merge({(k): v}) %}
{% endfor %}
{% set layout = o.layout ?: 'slider' %}
{% set direction = o.direction ?: 'to_left' %}

{% set entries = [] %}
{% if component.use_custom %}
    {% for item in component.items %}
        {% if item.title or item.image %}
            {% set entries = entries|merge([{'name': item.title, 'url': item.url, 'image': item.image, 'icon': null}]) %}
        {% endif %}
    {% endfor %}
{% else %}
    {% for cat in component.categories %}
        {% set entries = entries|merge([{'name': cat.name, 'url': cat.url, 'image': cat.image, 'icon': cat.icon}]) %}
    {% endfor %}
{% endif %}

{% if entries|length %}
{% set sizes = {'sm': 88, 'md': 132, 'lg': 160, 'xl': 190} %}
{% set size_px = sizes[o.size ?: 'md'] ?? 132 %}
{% set ring_w = component.ring_width is not null and component.ring_width != '' ? component.ring_width : 3 %}
{% set gap = component.gap is not null and component.gap != '' ? component.gap : 20 %}
{% set speed = component.speed ?: 30 %}
{% set css_vars = [
    '--sh-cat-size:' ~ size_px ~ 'px',
    '--sh-cat-ring-w:' ~ (o.ring == 'none' ? 0 : ring_w) ~ 'px',
    '--sh-cat-gap:' ~ gap ~ 'px',
    '--sh-cat-speed:' ~ speed ~ 's',
    '--sh-cat-cols:' ~ (component.cols_desktop ?: 6),
    '--sh-cat-cols-m:' ~ (component.cols_mobile ?: 3)
] %}
{% if component.ring_color %}{% set css_vars = css_vars|merge(['--sh-cat-ring:' ~ component.ring_color]) %}{% endif %}
{% if component.name_color %}{% set css_vars = css_vars|merge(['--sh-cat-name:' ~ component.name_color]) %}{% endif %}

{% set classes = [
    'sh-cats--' ~ layout,
    'sh-cats--shape-' ~ (o.shape ?: 'circle'),
    'sh-cats--ring-' ~ (o.ring ?: 'gradient'),
    'sh-cats--hover-' ~ (o.hover ?: 'lift'),
    'sh-cats--fit-' ~ (o.image_fit ?: 'cover'),
    'sh-cats--bg-' ~ (o.image_bg ?: 'ivory'),
    'sh-cats--name-' ~ (o.name_position ?: 'below'),
    'sh-cats--name-' ~ (o.name_size ?: 'md'),
    component.ring_spin ? 'sh-cats--spin' : '',
    component.inner_gap is same as(false) ? 'sh-cats--no-gap' : '',
    component.shadow ? 'sh-cats--shadow' : '',
    component.grayscale ? 'sh-cats--gray' : ''
] %}

<section component-id="{{ componentId }}" data-testid="hn-categories"
         class="s-block sh-cats {{ classes|filter(c => c)|join(' ') }} {% include 'components.hamsa.section-classes' %}"
         style="{{ css_vars|join(';') }}">
    <div class="container">
        {% if component.title or component.eyebrow %}
            <div class="sh-section-head sh-reveal">
                {% if component.eyebrow %}<span class="sh-eyebrow">{{ component.eyebrow }}</span>{% endif %}
                {% if component.title %}<h2 class="sh-section-head__title">{{ component.title }}</h2>{% endif %}
                {% if component.description %}<p class="sh-section-head__desc">{{ component.description }}</p>{% endif %}
            </div>
        {% endif %}

        {% if layout == 'marquee' %}
            {# repeat the list until one copy is wide enough, then render it twice for a seamless loop #}
            {% set reps = (12 / entries|length)|round(0, 'ceil') %}
            {% set group = [] %}
            {% for i in 1..(reps < 1 ? 1 : reps) %}{% set group = group|merge(entries) %}{% endfor %}
            <div class="sh-loop sh-loop--{{ direction|replace({'_': '-'}) }} {{ component.pause_on_hover is same as(false) ? '' : 'sh-loop--pause' }}">
                <div class="sh-loop__rail">
                    {% for copy in 1..2 %}
                        <ul class="sh-loop__track" {{ copy == 2 ? 'aria-hidden="true"' : '' }}>
                            {% for entry in group %}
                                {% set hidden_copy = copy == 2 or loop.index > entries|length %}
                                <li class="sh-loop__item">{% include 'components.hamsa.category-item' with {'entry': entry, 'hidden_copy': hidden_copy} %}</li>
                            {% endfor %}
                        </ul>
                    {% endfor %}
                </div>
            </div>
        {% elseif layout == 'grid' or layout == 'scroll' %}
            <ul class="sh-cats__{{ layout }}">
                {% for entry in entries %}
                    <li>{% include 'components.hamsa.category-item' with {'entry': entry, 'hidden_copy': false} %}</li>
                {% endfor %}
            </ul>
        {% else %}
            {% set slider_config = {'spaceBetween': gap + 0} %}
            {# Swiper moves toward the reading direction; reverse it when the merchant asked for the other way #}
            {% set reverse = theme.is_rtl ? direction == 'to_left' : direction == 'to_right' %}
            {% if component.autoplay %}
                {% set slider_config = slider_config|merge({'loop': true, 'autoplay': {'delay': 2600, 'disableOnInteraction': false, 'pauseOnMouseEnter': component.pause_on_hover is same as(false) ? false : true, 'reverseDirection': reverse}}) %}
            {% endif %}
            <salla-slider
                type="carousel"
                id="sh-cats-{{ position }}"
                show-controls="{{ component.show_controls ? 'true' : 'false' }}"
                {{ component.autoplay ? 'auto-play' : '' }}
                slider-config='{{ slider_config|json_encode|raw }}'
                controls-outer>
                <div slot="items">
                    {% for entry in entries %}
                        <div class="swiper-slide sh-cats__slide">
                            {% include 'components.hamsa.category-item' with {'entry': entry, 'hidden_copy': false} %}
                        </div>
                    {% endfor %}
                </div>
            </salla-slider>
        {% endif %}
    </div>
</section>
{% endif %}
