{% set component = component|default({}) %}
{% set o = {} %}{% for k in ['columns'] %}{% set v = attribute(component, k) %}{% if v is iterable %}{% set v = v.value ?? (v|first).value ?? null %}{% endif %}{% set o = o|merge({(k): v}) %}{% endfor %}
{% set hn_mod = ['hn-vp-cols--' ~ (o.columns ?: '3'), component.show_icons is same as(false) ? 'hn-vp--no-icons' : '']|filter(c => c)|join(' ') %}
{#
| Variable                    | Type   | Description                                              |
|------------------------------|--------|-------------------------------------------------------------|
| component.items[].icon       | string |                                                              |
| component.items[].label      | string | مثال: "تغليف هدايا مجاني"، "ضمان الأصالة"، "تفصيل حسب الطلب" |
| position                     | int    |                                                              |
#}
{% set items = component.items|default([]) %}
{% if items|length %}
<section component-id="{{ componentId }}" class="s-block hn-value-props {{ hn_mod }}">
    {% for item in items %}
    <div class="hn-value-props__item">
        <img src="{{ item.icon }}" alt="">
        <span>{{ item.label }}</span>
    </div>
    {% endfor %}
</section>
{% endif %}
