{% set component = component|default({}) %}
{% set o = {} %}
{% set hn_mod = ['hn-boxed']|filter(c => c)|join(' ') %}
{% set items = component.items|default([]) %}
{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-compare {{ hn_mod }} {% include 'components.hamsa.section-classes' %}" data-hn-compare><div class="s-block__title"><h2>{{ component.title|default(trans('hn.v92.compare_title')) }}</h2><p>{{ trans('hn.v92.compare_hint') }}</p></div><div class="hn-compare__grid">{% for item in items %}<label class="hn-compare-card"><input type="checkbox" data-hn-compare-item value="{{ loop.index }}"><img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy"><strong>{{ item.name }}</strong><span>{{ item.price }}</span></label>{% endfor %}</div><button type="button" class="hn-btn hn-btn--gold" data-hn-compare-open disabled>{{ trans('hn.v92.compare_action') }}</button><div class="hn-compare__result" data-hn-compare-result hidden></div></section>{% endif %}