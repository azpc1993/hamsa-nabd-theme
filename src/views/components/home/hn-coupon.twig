{#
| Variable                 | Type     | Description                                                   |
|--------------------------|----------|---------------------------------------------------------------|
| component.image          | ?string  | Optional side image                                           |
| component.discount       | ?string  | Big label, e.g. "20%"                                         |
| component.eyebrow        | ?string  |                                                               |
| component.title          | ?string  |                                                               |
| component.description    | ?string  |                                                               |
| component.code           | string   | Coupon code (created in Salla › Marketing › Coupons)          |
| component.end_date       | ?string  | Optional countdown end date                                   |
| component.button_text    | ?string  |                                                               |
| component.button_url     | ?string  |                                                               |
| position                 | int      | Sorting number start from zero                                |
#}
{% set o = {} %}
{% for k in ['style', 'badge_shape'] %}
    {% set v = attribute(component, k) %}
    {% if v is iterable %}{% set v = v.value ?? (v|first).value ?? null %}{% endif %}
    {% set o = o|merge({(k): v}) %}
{% endfor %}
{% set hn_mod = [
    'sh-coupon--' ~ (o.style ?: 'ticket'),
    'sh-coupon--badge-' ~ (o.badge_shape ?: 'circle')
]|filter(c => c)|join(' ') %}
{% set hn_style = [
    ''
]|filter(c => c)|join(';') %}
{% set expired = component.hide_after_end and component.end_date and component.end_date|trim matches '/^[0-9]{4}-[0-9]{2}-[0-9]{2}/' and date(component.end_date|trim) < date() %}
{% if component.code and not expired %}
<section component-id="{{ componentId }}" data-testid="hn-coupon" style="{{ hn_style }}" class="s-block sh-coupon {{ hn_mod }} {% include 'components.hamsa.section-classes' %}">
    <div class="container">
        <div class="sh-coupon__card sh-reveal {{ component.image ? 'sh-coupon__card--media' : '' }}">
            {% if component.discount and o.badge_shape != 'none' %}
                <div class="sh-coupon__badge" aria-hidden="true">
                    <span class="sh-coupon__value">{{ component.discount }}</span>
                    <span class="sh-coupon__off">{{ trans('blocks.hamsa.off') }}</span>
                </div>
            {% endif %}

            <div class="sh-coupon__body">
                {% if component.eyebrow %}<span class="sh-eyebrow">{{ component.eyebrow }}</span>{% endif %}
                {% if component.title %}<h2 class="sh-coupon__title">{{ component.title }}</h2>{% endif %}
                {% if component.description %}<p class="sh-coupon__desc">{{ component.description }}</p>{% endif %}

                <div class="sh-coupon__code-row">
                    <div class="sh-coupon__code" dir="ltr">{{ component.code }}</div>
                    <button type="button" class="sh-btn sh-btn--gold sh-copy"
                            data-sh-copy="{{ component.code|e('html_attr') }}"
                            data-copied-text="{{ trans('blocks.hamsa.copied')|e('html_attr') }}">
                        <i class="sicon-page-alt"></i>
                        <span>{{ trans('blocks.hamsa.copy_code') }}</span>
                    </button>
                </div>

                <div class="sh-coupon__footer">
                    {% if component.end_date %}
                        <salla-count-down date="{{ component.end_date|trim }}" size="sm" color="dark" labeled
                                          end-text="{{ trans('blocks.hamsa.offer_ended') }}"></salla-count-down>
                    {% endif %}
                    {% if component.button_text and component.button_url %}
                        <a href="{{ component.button_url }}" class="sh-coupon__link">{{ component.button_text }} <i class="sicon-arrow-left"></i></a>
                    {% endif %}
                </div>
            </div>

            {% if component.image %}
                <div class="sh-coupon__media">
                    <img src="{{ component.image }}" alt="{{ (component.title ?: store.name)|e('html_attr') }}" loading="lazy">
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}
