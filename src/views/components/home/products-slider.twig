{#
  مكوّن سلة الأساسي: "منتجات متحركة" (feature: component-products-slider)
| Variable              | Type    | Description                              |
|-----------------------|---------|------------------------------------------|
| products.source       | string  |                                          |
| products.source_value | ?int[]  | ids of sources                           |
| title                 | string  |                                          |
| sub_title             | ?string |                                          |
| display_all_url       | ?string |                                          |
| limit                 | int     |                                          |
| position              | int     |                                          |
#}
<section component-id="{{ componentId }}" class="s-block hn-builtin hn-products-slider container overflow-hidden">
  {% if products|default(null) %}
    <salla-products-slider
        source="{{ products.source|default('latest') }}"
        source-value="{{ products.source_value|default([])|json_encode }}"
        limit="{{ limit|default(8) }}"
        autoplay
        display-all-url="{{ display_all_url|default('') }}"
        block-title="{{ title|default('') }}"
        block-subTitle="{{ sub_title|default('')|raw }}"
        slider-id="hn-products-slider-{{ position|default(0) }}"></salla-products-slider>
  {% endif %}
</section>
