<section component-id="{{ componentId }}" class="s-block hn-whatsapp-order"><div><h2>{{ component.title|default(trans('hn.features.whatsapp_title')) }}</h2>{% if component.text %}<p>{{ component.text }}</p>{% endif %}</div>{% set phone = component.phone|default(store.contacts.whatsapp) %}{% if phone %}<a class="hn-btn hn-btn--whatsapp" target="_blank" rel="noopener noreferrer" href="https://wa.me/{{ phone|replace({' ': '', '+': ''}) }}?text={{ (component.message|default(trans('hn.features.whatsapp_message')))|url_encode }}">{{ component.button_text|default(trans('hn.features.whatsapp_button')) }}</a>{% endif %}</section>