{% set component = component|default({}) %}
{% set o = {} %}{% for k in ['image_shape', 'layout'] %}{% set v = attribute(component, k) %}{% if v is iterable %}{% set v = v.value ?? (v|first).value ?? null %}{% endif %}{% set o = o|merge({(k): v}) %}{% endfor %}
{% set hn_mod = ['hn-icon-cats--' ~ (o.image_shape ?: 'circle'), 'hn-icon-cats--' ~ (o.layout ?: 'scroll')]|filter(c => c)|join(' ') %}
{#
| Variable                      | Type   | Description                     |
|-------------------------------|--------|---------------------------------|
| component.title               | ?string| عنوان القسم                      |
| component.image_shape         | string | circle / rounded / square / rect |
| component.layout              | string | scroll / grid                   |
| component.categories[].icon   | string | رابط صورة الأيقونة                |
| component.categories[].name   | string |                                 |
| component.categories[].url    | string |                                 |
| position                      | int    |                                 |
#}
{% set cats = component.categories|default([]) %}
{% if cats|length %}
<section component-id="{{ componentId }}" class="s-block hn-icon-cats-block {{ hn_mod }}">
    {% if component.title %}
        <div class="s-block__title"><h2>{{ component.title }}</h2></div>
    {% endif %}
    <nav class="hn-icon-cats">
        {% for cat in cats %}
        <a href="{{ cat.url }}" class="hn-icon-cats__item">
            <span class="hn-icon-cats__circle"><img src="{{ cat.icon }}" alt="" loading="lazy"></span>
            <span class="hn-icon-cats__label">{{ cat.name }}</span>
        </a>
        {% endfor %}
    </nav>
</section>
{% endif %}
