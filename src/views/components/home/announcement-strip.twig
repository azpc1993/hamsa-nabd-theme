{% set component = component|default({}) %}
{#
| Variable                     | Type    |
|------------------------------|---------|
| component.messages[].text    | string  |
| component.messages[].code    | ?string |
| position                     | int     |
#}
{% set messages = component.messages|default([]) %}
{% if messages|length %}
<section component-id="{{ componentId }}" class="s-block hn-announcement">
    <div class="hn-announcement__track">
        {% for i in 1..2 %}
            {% for msg in messages %}
            <span class="hn-announcement__item" {{ i == 2 ? 'aria-hidden="true"' : '' }}>
                {{ msg.text }}
                {% if msg.code %}<strong class="hn-announcement__code">{{ msg.code }}</strong>{% endif %}
            </span>
            {% endfor %}
        {% endfor %}
    </div>
</section>
{% endif %}
