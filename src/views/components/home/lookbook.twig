{% set component = component|default({}) %}
{% set o = {} %}
{% set hn_mod = [component.show_prices is same as(false) ? 'hn-lookbook--no-prices' : '']|filter(c => c)|join(' ') %}
{#
| Variable                   | Type    | Description                                  |
|-----------------------------|---------|------------------------------------------------|
| component.title            | ?string |                                                |
| component.looks[].image    | string  | صورة الإطلالة الكاملة                          |
| component.looks[].caption  | ?string |                                                |
| component.looks[].hotspotN_name/_price/_x/_y/_url | ?string | حتى 3 نقاط منتج ثابتة لكل إطلالة (N = 1..3) |
| position                   | int     |                                                |
#}
{% set looks = component.looks|default([]) %}
{% if looks|length %}
<section component-id="{{ componentId }}" class="s-block hn-lookbook {{ hn_mod }}">
    {% if component.title %}
        <div class="s-block__title"><h2>{{ component.title }}</h2></div>
    {% endif %}

    <div class="hn-lookbook__grid">
        {% for look in looks %}
        <div class="hn-lookbook__item">
            <img src="{{ look.image }}" alt="{{ look.caption }}" loading="lazy">
            {% if look.caption %}<span class="hn-lookbook__caption">{{ look.caption }}</span>{% endif %}

            {% for i in 1..3 %}
                {% set name = attribute(look, 'hotspot' ~ i ~ '_name') %}
                {% if name %}
                <button class="hn-lookbook__hotspot"
                        style="right:{{ attribute(look, 'hotspot' ~ i ~ '_x')|default(50) }}%; top:{{ attribute(look, 'hotspot' ~ i ~ '_y')|default(50) }}%;"
                        data-hn-hotspot>
                    <span class="hn-lookbook__hotspot-dot"></span>
                    <span class="hn-lookbook__hotspot-card">
                        <a href="{{ attribute(look, 'hotspot' ~ i ~ '_url') }}">
                            <b>{{ name }}</b>
                            {% set price = attribute(look, 'hotspot' ~ i ~ '_price') %}
                            {% if price %}<span>{{ price }}</span>{% endif %}
                        </a>
                    </span>
                </button>
                {% endif %}
            {% endfor %}
        </div>
        {% endfor %}
    </div>
</section>
{% endif %}
