{% set items = component.items|default([]) %}{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-faq"><div class="s-block__title"><h2>{{ component.title|default(trans('hn.features.faq_title')) }}</h2></div><div class="hn-faq__list">{% for item in items %}<details class="hn-faq__item"><summary>{{ item.question }}</summary><div>{{ item.answer }}</div></details>{% endfor %}</div></section>{% endif %}