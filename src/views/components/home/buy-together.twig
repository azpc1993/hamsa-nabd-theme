{% set items = component.items|default([]) %}
{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-buy-together"><div class="s-block__title"><h2>{{ component.title|default(trans('hn.features.buy_together_title')) }}</h2>{% if component.subtitle %}<p>{{ component.subtitle }}</p>{% endif %}</div><div class="hn-buy-together__items">{% for item in items %}<a class="hn-bundle-item" href="{{ item.url|default('#') }}"><img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy"><span>{{ item.name }}</span>{% if item.price %}<strong>{{ item.price }}</strong>{% endif %}</a>{% endfor %}</div>{% if component.button_url %}<a href="{{ component.button_url }}" class="hn-btn hn-btn--gold">{{ component.button_text|default(trans('hn.features.shop_bundle')) }}</a>{% endif %}</section>{% endif %}