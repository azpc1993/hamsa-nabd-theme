{#
| Variable                   | Type     | Description                                                   |
|----------------------------|----------|---------------------------------------------------------------|
| component.background       | ?string  | Optional background image                                     |
| component.eyebrow          | ?string  |                                                               |
| component.title            | ?string  |                                                               |
| component.description      | ?string  |                                                               |
| component.whatsapp_url     | ?string  | WhatsApp channel / group link                                 |
| component.telegram_url     | ?string  |                                                               |
| component.instagram_url    | ?string  |                                                               |
| component.snapchat_url     | ?string  |                                                               |
| component.tiktok_url       | ?string  |                                                               |
| position                   | int      | Sorting number start from zero                                |
#}
{% set o = {} %}
{% for k in ['style', 'button_shape'] %}
    {% set v = attribute(component, k) %}
    {% if v is iterable %}{% set v = v.value ?? (v|first).value ?? null %}{% endif %}
    {% set o = o|merge({(k): v}) %}
{% endfor %}
{% set hn_mod = [
    'sh-join--' ~ (o.style ?: 'dark'),
    'sh-join--btn-' ~ (o.button_shape ?: 'rounded'),
    component.brand_colors ? 'sh-join--brand' : '',
    component.centered ? 'sh-join--center' : ''
]|filter(c => c)|join(' ') %}
{% set hn_style = [
    ''
]|filter(c => c)|join(';') %}
{% set channels = [
    {'url': component.whatsapp_url,  'icon': 'sicon-whatsapp',  'label': 'WhatsApp',  'mod': 'wa'},
    {'url': component.telegram_url,  'icon': 'sicon-paper-plane',  'label': 'Telegram',  'mod': 'tg'},
    {'url': component.instagram_url, 'icon': 'sicon-instagram', 'label': 'Instagram', 'mod': 'ig'},
    {'url': component.snapchat_url,  'icon': 'sicon-snapchat',  'label': 'Snapchat',  'mod': 'sc'},
    {'url': component.tiktok_url,    'icon': 'sicon-tiktok',    'label': 'TikTok',    'mod': 'tt'}
]|filter(c => c.url) %}
{% if channels|length %}
<section component-id="{{ componentId }}" data-testid="hn-join-channel" style="{{ hn_style }}" class="s-block sh-join {{ hn_mod }} {% include 'components.hamsa.section-classes' %}">
    <div class="container">
        <div class="sh-join__band sh-reveal" {% if component.background %}style="--sh-join-bg: url('{{ component.background }}');"{% endif %}>
            <div class="sh-join__text">
                {% if component.eyebrow %}<span class="sh-eyebrow">{{ component.eyebrow }}</span>{% endif %}
                {% if component.title %}<h2 class="sh-join__title">{{ component.title }}</h2>{% endif %}
                {% if component.description %}<p class="sh-join__desc">{{ component.description }}</p>{% endif %}
            </div>
            <div class="sh-join__actions">
                {% for ch in channels %}
                    <a href="{{ ch.url }}" target="_blank" rel="noopener" class="sh-join__btn sh-join__btn--{{ ch.mod }}">
                        <i class="{{ ch.icon }}" aria-hidden="true"></i><span>{{ ch.label }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
{% endif %}
