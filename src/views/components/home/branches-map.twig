{% set component = component|default({}) %}
{% set items = component.items|default([]) %}
{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-branches"><div class="s-block__title"><h2>{{ component.title|default(trans('hn.v92.branches_title')) }}</h2></div><div class="hn-branches__grid">{% for item in items %}<article class="hn-branch"><div><h3>{{ item.name }}</h3><p>{{ item.address }}</p><small>{{ item.hours }}</small></div>{% if item.map_url %}<a class="hn-btn hn-btn--outline" href="{{ item.map_url }}" target="_blank" rel="noopener noreferrer">{{ trans('hn.v92.open_map') }}</a>{% endif %}</article>{% endfor %}</div></section>{% endif %}