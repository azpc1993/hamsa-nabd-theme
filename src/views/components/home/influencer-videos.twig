{% set component = component|default({}) %}
{% set o = {} %}
{% set hn_mod = ['hn-boxed']|filter(c => c)|join(' ') %}
{% set items = component.items|default([]) %}
{% if items|length %}<section component-id="{{ componentId }}" class="s-block hn-influencers {{ hn_mod }} {% include 'components.hamsa.section-classes' %}"><div class="s-block__title"><h2>{{ component.title|default(trans('hn.v92.influencer_title')) }}</h2></div><div class="hn-influencers__grid">{% for item in items %}<article class="hn-influencer">{% if item.video %}<video controls muted playsinline preload="metadata" poster="{{ item.poster }}"><source src="{{ item.video }}"></video>{% else %}<img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy">{% endif %}<div class="hn-influencer__body"><strong>{{ item.name }}</strong><p>{{ item.caption }}</p>{% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ trans('hn.v92.watch') }}</a>{% endif %}</div></article>{% endfor %}</div></section>{% endif %}