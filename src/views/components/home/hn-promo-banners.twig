{#
| Variable                         | Type     | Description                                                   |
|----------------------------------|----------|---------------------------------------------------------------|
| component                        | object   | Merchant settings for fields from twilight.json `components`  |
| component.title                  | ?string  | Optional section title                                        |
| component.banners                | object[] | 1–3 banners                                                   |
| component.banners[].image        | string   |                                                               |
| component.banners[].eyebrow      | ?string  |                                                               |
| component.banners[].title        | ?string  |                                                               |
| component.banners[].button_text  | ?string  |                                                               |
| component.banners[].url          | ?string  |                                                               |
| position                         | int      | Sorting number start from zero                                |
#}
{% set o = {} %}
{% for k in ['height', 'content_pos', 'hover', 'radius'] %}
    {% set v = attribute(component, k) %}
    {% if v is iterable %}{% set v = v.value ?? (v|first).value ?? null %}{% endif %}
    {% set o = o|merge({(k): v}) %}
{% endfor %}
{% set hn_mod = [
    'sh-promos--h-' ~ (o.height ?: 'medium'),
    'sh-promos--pos-' ~ (o.content_pos ?: 'bottom_start')|replace({'_': '-'}),
    'sh-promos--hover-' ~ (o.hover ?: 'frame'),
    o.radius and o.radius != 'theme' ? 'sh-promos--radius-' ~ o.radius : ''
]|filter(c => c)|join(' ') %}
{% set hn_style = [
    '--sh-promo-shade:' ~ ((component.overlay_opacity is not null and component.overlay_opacity != '' ? component.overlay_opacity : 80) / 100),
    '--sh-promo-gap:' ~ (component.gap is not null and component.gap != '' ? component.gap : 20) ~ 'px'
]|filter(c => c)|join(';') %}
{% set banners = component.banners %}
{% set count = banners|length > 3 ? 3 : banners|length %}
{% if count %}
<section component-id="{{ componentId }}" data-testid="hn-promo-banners" style="{{ hn_style }}" class="s-block sh-promos {{ hn_mod }} {% include 'components.hamsa.section-classes' %}">
    <div class="container">
        {% if component.title %}
            <div class="sh-section-head sh-reveal">
                <h2 class="sh-section-head__title">{{ component.title }}</h2>
            </div>
        {% endif %}

        <div class="sh-promos__grid sh-promos__grid--{{ count }}">
            {% for banner in banners|slice(0, 3) %}
                <a href="{{ banner.url ?: '#' }}" class="sh-promo sh-reveal {{ count == 3 and loop.first ? 'sh-promo--lead' : '' }}"
                   aria-label="{{ (banner.title ?: 'promo-' ~ loop.index)|e('html_attr') }}">
                    <img src="{{ banner.image }}" alt="{{ (banner.title ?: store.name)|e('html_attr') }}" loading="lazy" class="sh-promo__img">
                    {% if banner.title or banner.eyebrow or banner.button_text %}
                        <span class="sh-promo__shade" aria-hidden="true"></span>
                        <span class="sh-promo__content">
                            {% if banner.eyebrow %}<span class="sh-eyebrow">{{ banner.eyebrow }}</span>{% endif %}
                            {% if banner.title %}<h3 class="sh-promo__title">{{ banner.title }}</h3>{% endif %}
                            {% if banner.button_text %}
                                <span class="sh-promo__cta">{{ banner.button_text }} <i class="sicon-arrow-left"></i></span>
                            {% endif %}
                        </span>
                    {% endif %}
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
