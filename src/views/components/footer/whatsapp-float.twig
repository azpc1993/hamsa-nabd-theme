{#
| Variable                 | Type    | Description                     |
|--------------------------|---------|---------------------------------|
| store.contacts.whatsapp  | ?string | رقم/رابط واتساب من إعدادات المتجر |
#}
{% if store.contacts.whatsapp %}
<a href="{{ store.contacts.whatsapp }}"
   class="hn-whatsapp-float"
   target="_blank" rel="noopener"
   data-hn-copy-link="true"
   aria-label="{{ trans('hn.accessibility.whatsapp') }}">
    <i class="sicon-whatsapp"></i>
</a>
{% endif %}
