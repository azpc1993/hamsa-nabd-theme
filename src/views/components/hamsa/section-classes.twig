{#- Shared "section settings" classes for Hamsa Nabd home components (sec_bg, sec_spacing, sec_visibility, head_align).
    Usage inside a class attribute:  {% include 'components.hamsa.section-classes' %} -#}
{%- set hn_sec = [] -%}
{%- for k in ['sec_bg', 'sec_spacing', 'sec_visibility', 'head_align'] -%}
    {%- set v = attribute(component, k) -%}
    {%- if v is iterable -%}{%- set v = v.value ?? (v|first).value ?? null -%}{%- endif -%}
    {%- if v and v not in ['none', 'normal', 'all', 'center'] or (k == 'sec_spacing' and v == 'none') -%}
        {%- set hn_sec = hn_sec|merge(['sh-sec--' ~ k|replace({'sec_': '', '_': '-'}) ~ '-' ~ v|replace({'_': '-'})]) -%}
    {%- endif -%}
{%- endfor -%}
{{- hn_sec|join(' ') -}}
