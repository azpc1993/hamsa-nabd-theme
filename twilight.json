    "component-latest-products",
    "component-fixed-banner",
    "component-square-photos",
    "component-brands",
    "component-store-features",
    "component-testimonials"
  ],
  "settings": [
    {
      "id": "hn_colors",
      "type": "settings-group",
      "label": {
        "ar": "الألوان",
        "en": "Colors"
      },
      "fields": [
        {
          "id": "color_primary",
          "type": "string",
          "format": "color",
          "label": "اللون الأساسي (نيفي)",
          "value": "#0B1F3A"
        },
        {
          "id": "color_accent",
          "type": "string",
          "format": "color",
          "label": "لون التمييز (ذهبي)",
          "value": "#C9A24B"
        },
        {
          "id": "color_dark_section_bg",
          "type": "string",
          "format": "color",
          "label": "خلفية الأقسام الداكنة",
          "value": "#0B1F3A"
        }
      ]
    },
    {
      "id": "hn_header",
      "type": "settings-group",
      "label": {
        "ar": "الهيدر",
        "en": "Header"
      },
      "fields": [
        {
          "id": "show_trust_badges",
          "type": "boolean",
          "format": "switch",
          "label": "إظهار شارات الثقة",
          "value": true
        },
        {
          "id": "show_bottom_nav",
          "type": "boolean",
          "format": "switch",
          "label": "شريط تنقل سفلي بالجوال",
          "value": true
        }
      ]
    },
    {
      "id": "hn_product",
      "type": "settings-group",
      "label": {
        "ar": "صفحة المنتج",
        "en": "Product Page"
      },
      "fields": [
        {
          "id": "product_show_breadcrumbs",
          "type": "boolean",
          "format": "switch",
          "label": "إظهار مسار التنقل",
          "value": true
        },
        {
          "id": "show_sticky_cart",
          "type": "boolean",
          "format": "switch",
          "label": "شريط شراء ثابت بالجوال",
          "value": true
        }
      ]
    },
    {
      "id": "hn_whatsapp",
      "type": "settings-group",
      "label": {
        "ar": "واتساب",
        "en": "WhatsApp"
      },
      "fields": [
        {
          "id": "whatsapp_number",
          "type": "string",
          "format": "text",
          "label": "رقم واتساب",
          "value": null
